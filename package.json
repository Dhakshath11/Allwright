{
  "name": "allwright",
  "private": true,
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:mobile": "mobilewright test --config apps/mobile/mobilewright.config.ts",
    "test:mobile:snapshots": "mobilewright test --config apps/mobile/snapshots.config.ts",
    "test:web": "playwright test --config apps/web/playwright.config.ts",
    "test:web:snapshots": "playwright test --config apps/web/snapshots.config.ts",
    "test:api": "playwright test --config apps/api/playwright.config.ts",
    "test:api:sample": "playwright test --config apps/api/playwright.config.ts apps/api/sample/tests/sample_api.spec.ts",
    "test:api:client": "playwright test --config apps/api/playwright.config.ts apps/api/sample/tests/users_client_api.spec.ts",
    "test": "npm run test:mobile test:web test:api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@mobilewright/test": "^0.0.44",
    "@playwright/cli": "^0.1.14",
    "@playwright/test": "^1.58.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "latest",
    "eslint": "^10.8.0",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "mobilewright": "^0.0.44",
    "typescript-eslint": "^8.60.1"
  }
}
